# Supabase (PostgreSQL)
# Pooler URL (runtime) — if the password has special characters, percent-encode them
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct connection (used by Prisma migrations / db push)
DIRECT_URL="postgresql://postgres.<project-ref>:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# Supabase Storage (product / banner image uploads)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
JWT_SECRET="change-this-to-a-long-random-string"
PORT=3001
